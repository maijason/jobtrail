{
  "manifest_version": 3,
  "name": "JobTrail",
  "version": "0.1.0",
  "description": "Save the job posting you're viewing to JobTrail.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to JobTrail"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"]
}
