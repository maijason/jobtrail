# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://jobtrail:jobtrail@localhost:5432/jobtrail

# Gemini API key for requirement extraction and matching.
# Get one at https://aistudio.google.com (free tier available).
GEMINI_API_KEY=
# Optional: which Gemini model to use (defaults to gemini-3.5-flash-lite).
# GEMINI_MODEL=
